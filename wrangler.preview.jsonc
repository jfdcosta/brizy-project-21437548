{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eco-storefront-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "vars": {
    "STOREFRONT_PREVIEW": "1"
  }
}
