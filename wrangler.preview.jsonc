{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eco-storefront-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "vars": {
    "STOREFRONT_PREVIEW": "1",
    "STRIPE_MODE": "live",
    "LIVE_CHECKOUT_ENABLED": "1",
    "STORE_PRODUCT_SLUGS": "jdc-duo",
    "SHIPPING_COUNTRIES": "GB",
    "TAX_MODE": "none",
    "SHIPPING_RATE_ID": "shr_1UOznH0S61GdmERuUhqxmjBc"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDERS",
        "class_name": "CheckoutOrder"
      }
    ]
  },
  "migrations": [
    {
      "tag": "orders-v1",
      "new_sqlite_classes": [
        "CheckoutOrder"
      ]
    }
  ],
  "account_id": "f109e84b0e6739b73a5fb4e14141ee39"
}
